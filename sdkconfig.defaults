# Settings shared by every target. Combine with sdkconfig.defaults.esp32 or
# sdkconfig.defaults.linux via -DSDKCONFIG_DEFAULTS="a;b".
#
# NB: a defaults file only seeds a *new* sdkconfig. After editing one of these,
# delete the build directory's sdkconfig and re-run set-target, or the change is
# silently ignored.

# partitions.csv is committed; see the file for why the layout matters.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# esp-mqtt, trimmed to what the client in main/mqtt/ actually uses. It connects
# over plain TCP, so the SSL and websocket transports are dead weight -- and on
# the device that weight is flash in a 1920K app partition. Removing them does
# not remove mbedtls: tcp_transport still requires esp-tls either way.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
