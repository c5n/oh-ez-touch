# ESP-IDF build output and per-build configuration
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
compile_commands.json

# The simulator's emulated flash image (NVS), created on first run
state/

# Left over from the PlatformIO build, which this project no longer uses. The
# directory is several hundred megabytes of build output and downloaded
# libraries and can simply be deleted; the pattern stays so that a working copy
# that predates the move does not show it as untracked.
.pio/

# Simulator icons, generated by tools/fetch_sim_icons.py. Not committed: the
# openHAB classic icon set is EPL-2.0, incompatible with this project's GPL-3.0.
main/sim/icon_fixture_data.h

# Editor / IDE
.vscode/
.idea/
*.swp
