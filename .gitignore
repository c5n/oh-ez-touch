# ESP-IDF build output and per-build configuration
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
compile_commands.json

# Collected release builds, from tools/build_release.py
release/

# Local fleet data of tools/discover.py and tools/batchupdate.py: real
# hostnames and addresses, not for the repo
tools/devices.json
tools/devices_*.json
tools/retry.json
retry.json

# The device manager's runtime state and uploaded firmware images: real
# addresses and scanned results, not for the repo
devmgr/data/
devmgr/__pycache__/

# The simulator's emulated flash image (NVS), created on first run
state/

# Left over from the PlatformIO build, which this project no longer uses. The
# directory is several hundred megabytes of build output and downloaded
# libraries and can simply be deleted; the pattern stays so that a working copy
# that predates the move does not show it as untracked.
.pio/

# Simulator icons, generated by tools/fetch_sim_icons.py. Not committed: the
# openHAB classic icon set is EPL-2.0, incompatible with this project's GPL-3.0.
main/sim/icon_fixture_data.h

# The same icon set, rasterized by tools/fetch_openhab_icons.py. Not committed
# for the same reason.
openhab-icons/

# And the firmware's built-in copy of it, generated by tools/build_icon_set.py.
# Same licence, same reason -- see doc/icon-set.md.
main/icons/icon_set_data.h

# build_icon_set.py imports fetch_openhab_icons.py by path to reuse the listing
# and download code, and CPython caches the bytecode next to it.
tools/__pycache__/

# Editor / IDE
.vscode/
.idea/
*.swp
