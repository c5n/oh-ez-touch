{
    "general":
    {
        "hostname": "oheztouch-new"
    },
    "ntp":
    {
        "hostname":         "pool.ntp.org",
        "gmt_offset":       1,
        "daylightsaving":   false
    },
    "ui":
    {
        "theme":        "Material",
        "night_mode":   "off",
        "night_from":   22,
        "night_to":     6
    },
    "backlight":
    {
        "activity_timeout":     60,
        "normal_brightness":    100,
        "dim_brightness":       40
    },
    "beeper":
    {
        "enabled":  true,
        "volume":   25
    },
    "mqtt":
    {
        "enabled":  false,
        "hostname": "mosquitto",
        "port":     1883,
        "user":     "",
        "password": "",
        "topic":    "oheztouch",
        "interval": 60,
        "retain":   true
    },
    "ble":
    {
        "enabled":      false,
        "interval":     30,
        "window":       5,
        "rssi_min":     -90,
        "expire":       120,
        "publish_all":  false
    },
    "openhab":
    {
        "hostname": "localhost",
        "port":     8080,
        "sitemap":  "demo"
    },
    "sensors":
    {
        "bme280":
        {
            "use":      false,
            "interval": 180
        }
    }
}
